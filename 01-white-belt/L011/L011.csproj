<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LockingAndPolymorphism</RootNamespace>
    <!-- snippets/ are read-along files, one per rendered still, including one
         that is DELIBERATELY not valid C# (CS0509). Excluding the folder from
         compilation is the CS8802 gotcha PRODUCTION-SYSTEM.md §3 solves, and
         here it also keeps the rejected shape from breaking the real build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);snippets/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="snippets/**" />
  </ItemGroup>

</Project>
</content>
