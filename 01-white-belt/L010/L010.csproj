<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Interfaces</RootNamespace>
    <!-- snippets/ are read-along files, one per rendered still. Excluding them
         from compilation is the CS8802 gotcha PRODUCTION-SYSTEM.md §3 solves. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);snippets/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="snippets/**" />
  </ItemGroup>

</Project>
