<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One project on purpose. A real solution keeps the application and its
    tests in two projects. The lesson keeps both here so the whole thing is
    one folder and one command, and the README names that simplification.
    xUnit v3 test projects are executables, so `dotnet run` runs the tests.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ComponentTests</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);snippets/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="snippets/**" />
  </ItemGroup>

</Project>
