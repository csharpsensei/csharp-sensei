<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WideEvents</RootNamespace>
    <UserSecretsId>csharpsensei-v008-wide-events</UserSecretsId>
    <!-- snippets/ are read-along files for the video, never compiled. Removing
         this line causes CS0101/CS8802 duplicate-definition errors — see
         PRODUCTION-SYSTEM.md §3. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);snippets/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="snippets/**" />
  </ItemGroup>

</Project>
